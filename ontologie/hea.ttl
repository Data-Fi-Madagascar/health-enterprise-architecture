@prefix hea: <https://healmadagascar.mg/ontologie/hea#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix.archimate: <http://www.opengroup.org/xsd/archimate/3.1/> .
@base <https://healmadagascar.mg/ontologie/hea> .

<https://healmadagascar.mg/ontologie/hea> rdf:type owl:Ontology ;
    owl:versionInfo "2.0.0" ;
    rdfs:label "Ontologie HEA — Architecture d'Entreprise de la Santé Numérique" ;
    rdfs:comment "Ontologie du référentiel HEA (Madagascar). Conforme à la grammaire ArchiMate 3.1. Générée automatiquement depuis referentiel/**/*.md par compile_rdf.py" .

# ===================================================================
# Namespace HEA
# ===================================================================

hea: rdf:type owl:Namespace ;
    owl:iri <https://healmadagascar.mg/ontologie/hea#> .

# ===================================================================
# Classes — Niveau 1 (CAESN)
# ===================================================================

# --- Business ---
hea:FluxValeur rdf:type owl:Class ;
    rdfs:label "Flux de valeur" ;
    rdfs:comment "Flux de valeur national (VS-01..4). ArchiMate: Value Stream." .

hea:Capabilite rdf:type owl:Class ;
    rdfs:label "Capabilité CAESN" ;
    rdfs:comment "Capabilité stratégique du CAESN (CAP-01..18). ArchiMate: Capability." .

hea:Principe rdf:type owl:Class ;
    rdfs:label "Principe" ;
    rdfs:comment "Principe d'architecture (PA, PD, P-INT). ArchiMate: Principle (extension domain-specific)." .

hea:EtapeValeur rdf:type owl:Class ;
    rdfs:label "Étape de valeur" ;
    rdfs:comment "Étape au sein d'un flux de valeur (VS-xx-yy). ArchiMate: Value Activity." .

hea:ProcessusMetier rdf:type owl:Class ;
    rdfs:label "Processus métier" ;
    rdfs:comment "Processus métier du secteur santé (PRC-01..13). ArchiMate: Business Process." .

# --- Application ---
hea:Composant rdf:type owl:Class ;
    rdfs:label "Composant" ;
    rdfs:comment "Composant applicatif, infrastructure, sécurité ou gouvernance (CMP-01..46). ArchiMate: Application Component." .

# --- Motivation ---
hea:PartiePrenante rdf:type owl:Class ;
    rdfs:label "Partie prenante" ;
    rdfs:comment "Partie prenante du secteur santé (PP-01..10). ArchiMate: Stakeholder." .

# ===================================================================
# Classes — Niveau 2 (CNISN)
# ===================================================================

hea:CapaciteInteroperabilite rdf:type owl:Class ;
    rdfs:label "Capacité d'interopérabilité" ;
    rdfs:comment "Capacité d'interopérabilité CNISN (CAP-INT-01..16). ArchiMate: Capability." ;
    rdfs:subClassOf hea:Capabilite .

hea:Acteur rdf:type owl:Class ;
    rdfs:label "Acteur" ;
    rdfs:comment "Acteur métier — organisation ou personne (ACT-01..06). ArchiMate: Business Actor." .

hea:Role rdf:type owl:Class ;
    rdfs:label "Rôle" ;
    rdfs:comment "Rôle métier — responsabilité (ROL-01..05). ArchiMate: Business Role." .

# ===================================================================
# Classes — Niveau 3 (ARTSN)
# ===================================================================

hea:Fondation rdf:type owl:Class ;
    rdfs:label "Fondation" ;
    rdfs:comment "Fondation technique ARTSN (F-1..6). ArchiMate: Technology Service (extension)." .

hea:Exigence rdf:type owl:Class ;
    rdfs:label "Exigence" ;
    rdfs:comment "Exigence contextuelle ARTSN (ENF-1..5). ArchiMate: Requirement." .

hea:Chapitre rdf:type owl:Class ;
    rdfs:label "Chapitre ARTSN" ;
    rdfs:comment "Chapitre de l'architecture de référence technique (ART-0..12). ArchiMate: Plateau (extension domain-specific)." .

hea:ObjetDeDonnees rdf:type owl:Class ;
    rdfs:label "Objet de données" ;
    rdfs:comment "Objet de données du référentiel (DO-01..31). ArchiMate: Data Object." .

hea:ObjetMetier rdf:type owl:Class ;
    rdfs:label "Objet métier" ;
    rdfs:comment "Objet métier du référentiel (BO-01..07). ArchiMate: Business Object." .

# ===================================================================
# Classes — Niveau 4 (PTISN)
# ===================================================================

hea:Profil rdf:type owl:Class ;
    rdfs:label "Profil technique" ;
    rdfs:comment "Profil technique d'implémentation (PT-01..19). ArchiMate: Product (extension)." .

hea:Service rdf:type owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "Service technique transverse (SRV-01..06). ArchiMate: Technology Service / Application Service." .

hea:WorkPackage rdf:type owl:Class ;
    rdfs:label "Paquet de travail" ;
    rdfs:comment "Lot de travail ARTSN (WP-01..07). ArchiMate: Work Package." .

# ===================================================================
# Classes — Niveau 5 (Feuille de route)
# ===================================================================

hea:Plateau rdf:type owl:Class ;
    rdfs:label "Plateau" ;
    rdfs:comment "État cible de l'architecture (PL-01..03). ArchiMate: Plateau." .

hea:Gap rdf:type owl:Class ;
    rdfs:label "Écart" ;
    rdfs:comment "Écart entre plateaux (GAP-01..03). ArchiMate: Gap." .

hea:Lieu rdf:type owl:Class ;
    rdfs:label "Lieu" ;
    rdfs:comment "Localisation géographique (LOC-01..06). ArchiMate: Location." .

# ===================================================================
# Propriétés de relation — Conformes ArchiMate 3.1
# ===================================================================

# --- Association (lien générique, dernier recours) ---
# ArchiMate: "The Association relationship models a relationship between elements."
hea:related rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "lié à" ;
    rdfs:comment "Association ArchiMate — lien générique entre deux objets" ;
    owl:domain owl:Thing ;
    owl:range owl:Thing .

# --- Serving (un élément sert un autre) ---
# ArchiMate: "The Serving relationship associates a serving element with the served element."
# Merge de appliesTo (Composant→Capabilite) + gouverns (Composant→Processus) + serves (Service→Acteur)
hea:serves rdf:type owl:ObjectProperty ;
    rdfs:label "sert" ;
    rdfs:comment "Serving ArchiMate — un élément sert un autre (Composant sert Capabilite/Processus/Service, Service sert Acteur/Rôle)" ;
    owl:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Composant hea:Service)
    ] ;
    owl:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Capabilite hea:ProcessusMetier hea:Service hea:PartiePrenante hea:Acteur)
    ] .

# --- Realization (un élément réalise un autre) ---
# ArchiMate: "The Realization relationship models that an element (typically an active structure element)
# realizes another element (typically a behavioral element)."
hea:realizedBy rdf:type owl:ObjectProperty ;
    rdfs:label "réalisé par" ;
    rdfs:comment "Realization ArchiMate — un élément actif réalise un élément comportemental" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Capabilite hea:EtapeValeur)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Service hea:Composant)
    ] .

# --- Access (un élément comportemental accède à un objet) ---
# ArchiMate: "The Access relationship associates a behavioral element with an object that is accessed."
# Behavioral elements: Process, Function, Interaction, Service.
# Objects: Data Object, Artifact.
hea:accesses rdf:type owl:ObjectProperty ;
    rdfs:label "accède à" ;
    rdfs:comment "Access ArchiMate — un processus ou service accède à un objet de données" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:ProcessusMetier hea:Service)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:ObjetDeDonnees hea:ObjetMetier)
    ] .

# --- Assignment (responsabilité) ---
# ArchiMate: "The Assignment relationship models the assignment of responsibility for performing behavior
# to an entity that performs behavior."
hea:performs rdf:type owl:ObjectProperty ;
    rdfs:label "exécute" ;
    rdfs:comment "Assignment ArchiMate — un acteur ou rôle exécute un processus" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Acteur hea:Role)
    ] ;
    rdfs:range hea:ProcessusMetier .

hea:assignedTo rdf:type owl:ObjectProperty ;
    rdfs:label "assigné à" ;
    rdfs:comment "Assignment ArchiMate — un rôle est assigné à un acteur" ;
    rdfs:domain hea:Role ;
    rdfs:range hea:Acteur .

hea:hasRole rdf:type owl:ObjectProperty ;
    rdfs:label "a pour rôle" ;
    rdfs:comment "Assignment ArchiMate — un acteur a un rôle" ;
    rdfs:domain hea:Acteur ;
    rdfs:range hea:Role .

# --- Representation (un élément représente un autre) ---
# ArchiMate: "The Representation relationship models that an element is a representation of another element."
hea:represents rdf:type owl:ObjectProperty ;
    rdfs:label "représente" ;
    rdfs:comment "Representation ArchiMate — un acteur représente une partie prenante" ;
    rdfs:domain hea:Acteur ;
    rdfs:range hea:PartiePrenante .

# --- Influence (un élément influence un autre) ---
# ArchiMate: "The Influence relationship models that an element influences the change or behavior of another element."
hea:contributesTo rdf:type owl:ObjectProperty ;
    rdfs:label "contribue à" ;
    rdfs:comment "Influence ArchiMate — une étape de valeur ou un processus contribue à un flux de valeur" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:EtapeValeur hea:ProcessusMetier)
    ] ;
    rdfs:range hea:FluxValeur .

# --- Mapping inter-niveaux (Association, extension domain-specific) ---
# Pas de relationship ArchiMate standard pour la correspondance cross-layer.
# Utilisé comme Association avec contraintes de domaine/range.
hea:mapsTo rdf:type owl:ObjectProperty ;
    rdfs:label "correspond à" ;
    rdfs:comment "Association ArchiMate — correspondance inter-niveaux (Profil→CapInt/Chapitre/Fondation)" ;
    rdfs:domain hea:Profil ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:CapaciteInteroperabilite hea:Chapitre hea:Fondation hea:Composant)
    ] .

# --- Implements (Realization, extension domain-specific) ---
# Un profil met en œuvre un chapitre ou une fondation.
hea:implements rdf:type owl:ObjectProperty ;
    rdfs:label "met en œuvre" ;
    rdfs:comment "Realization ArchiMate — un profil met en œuvre un chapitre ou une fondation" ;
    rdfs:domain hea:Profil ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Chapitre hea:Fondation)
    ] .

# --- LocatedAt (Association, extension — pas d'équivalent direct ArchiMate) ---
# ArchiMate a un concept Location mais pas de relationship "locatedAt" standard.
# Modélisé comme Association.
hea:locatedAt rdf:type owl:ObjectProperty ;
    rdfs:label "situé à" ;
    rdfs:comment "Association ArchiMate — un composant ou service est situé dans un lieu" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Composant hea:Service)
    ] ;
    rdfs:range hea:Lieu .

# ===================================================================
# Propriétés de données (Datatype Properties)
# ===================================================================

hea:id rdf:type owl:DatatypeProperty ;
    rdfs:label "identifiant" ;
    rdfs:comment "Identifiant normalisé unique de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:title rdf:type owl:DatatypeProperty ;
    rdfs:label "titre" ;
    rdfs:comment "Titre canonique de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:status rdf:type owl:DatatypeProperty ;
    rdfs:label "statut" ;
    rdfs:comment "Statut de maturité (draft, active, stable, candidate, deprecated)" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:owner rdf:type owl:DatatypeProperty ;
    rdfs:label "propriétaire" ;
    rdfs:comment "Entité responsable de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:version rdf:type owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "Version de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:niveau rdf:type owl:DatatypeProperty ;
    rdfs:label "niveau" ;
    rdfs:comment "Niveau de référence : 1 (CAESN), 2 (CNISN), 3 (ARTSN), 4 (PTISN)" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:integer .

hea:tag rdf:type owl:DatatypeProperty ;
    rdfs:label "étiquette" ;
    rdfs:comment "Étiquette de catégorisation" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

# ===================================================================
# Restrictions de cardinalité (owl:Restriction)
# ===================================================================

# Tout profil doit avoir au moins 1 mapsTo
hea:ProfilMinMapsTo rdf:type owl:Restriction ;
    owl:onProperty hea:mapsTo ;
    owl:minCardinality 1 ;
    rdfs:subClassOf hea:Profil .

# Toute capabilité d'interopérabilité doit avoir au moins 1 mapsTo vers un CAP
hea:CapIntMinMapsTo rdf:type owl:Restriction ;
    owl:onProperty hea:mapsTo ;
    owl:minCardinality 1 ;
    rdfs:subClassOf hea:CapaciteInteroperabilite .
