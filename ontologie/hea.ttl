@prefix hea: <https://healmadagascar.mg/ontologie/hea#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix archimate: <http://www.opengroup.org/xsd/archimate/3.1/> .
@prefix fhir: <http://hl7.org/fhir/> .
@base <https://healmadagascar.mg/ontologie/hea> .

<https://healmadagascar.mg/ontologie/hea> rdf:type owl:Ontology ;
    owl:versionInfo "2.1.0" ;
    rdfs:label "Ontologie HEA — Architecture d'Entreprise de la Santé Numérique" ;
    rdfs:comment "Ontologie du référentiel HEA (Madagascar). Conforme à la grammaire ArchiMate 3.1. Les classes sont alignées sur le graphe compilé par compile_rdf.py, qui type chaque objet du référentiel. Le compilateur vérifie à chaque validation que toute classe employée par le graphe est déclarée ici." .

# ===================================================================
# Namespace HEA
# ===================================================================

hea: rdf:type owl:Namespace ;
    owl:iri <https://healmadagascar.mg/ontologie/hea#> .

# ===================================================================
# Classes — Niveau 1 (CAESN)
# ===================================================================

# --- Business ---
hea:FluxValeur rdf:type owl:Class ;
    rdfs:label "Flux de valeur" ;
    rdfs:comment "Flux de valeur national (VS-01..4). ArchiMate: Value Stream." .

hea:Valeur rdf:type owl:Class ;
    rdfs:label "Valeur" ;
    rdfs:comment "Valeur produite par un flux de valeur, détenue par une partie prenante. ArchiMate: Value (motivation layer)." .

hea:Capabilite rdf:type owl:Class ;
    rdfs:label "Capabilité CAESN" ;
    rdfs:comment "Capabilité stratégique du CAESN (CAP-01..18). ArchiMate: Capability." .

hea:Principe rdf:type owl:Class ;
    rdfs:label "Principe" ;
    rdfs:comment "Principe d'architecture (PA, PD, P-INT). ArchiMate: Principle (extension domain-specific)." .

hea:EtapeValeur rdf:type owl:Class ;
    rdfs:label "Étape de valeur" ;
    rdfs:comment "Étape au sein d'un flux de valeur (VS-xx-yy). ArchiMate: Value Activity." .

hea:ProcessusMetier rdf:type owl:Class ;
    rdfs:label "Processus métier" ;
    rdfs:comment "Processus métier du secteur santé (PRC-01..13). ArchiMate: Business Process." .

# --- Application ---
hea:Composant rdf:type owl:Class ;
    rdfs:label "Composant" ;
    rdfs:comment "Composant applicatif, infrastructure, sécurité ou gouvernance (CMP-01..46). ArchiMate: Application Component." .

# --- Motivation ---
hea:PartiePrenante rdf:type owl:Class ;
    rdfs:label "Partie prenante" ;
    rdfs:comment "Partie prenante du secteur santé (PP-01..10). ArchiMate: Stakeholder." .

# ===================================================================
# Classes — Niveau 2 (CNISN)
# ===================================================================

hea:CapaciteInteroperabilite rdf:type owl:Class ;
    rdfs:label "Capacité d'interopérabilité" ;
    rdfs:comment "Ancien paquet composite d'interopérabilité CNISN, décommissionné comme objet actif." ;
    rdfs:subClassOf hea:Capabilite .

hea:Acteur rdf:type owl:Class ;
    rdfs:label "Acteur" ;
    rdfs:comment "Acteur métier — organisation ou personne (ACT-01..06). ArchiMate: Business Actor." .

hea:Role rdf:type owl:Class ;
    rdfs:label "Rôle" ;
    rdfs:comment "Rôle métier — responsabilité (ROL-01..05). ArchiMate: Business Role." .

# ===================================================================
# Classes — Niveau 3 (ARTSN)
# ===================================================================

hea:Fondation rdf:type owl:Class ;
    rdfs:label "Fondation" ;
    rdfs:comment "Fondation technique ARTSN (F-1..6). ArchiMate: Technology Service (extension)." .

hea:Exigence rdf:type owl:Class ;
    rdfs:label "Exigence" ;
    rdfs:comment "Exigence contextuelle ARTSN (ENF-1..5). ArchiMate: Requirement." .

hea:Chapitre rdf:type owl:Class ;
    rdfs:label "Chapitre ARTSN" ;
    rdfs:comment "Chapitre de l'architecture de référence technique (ART-0..12). ArchiMate: Plateau (extension domain-specific)." .

hea:ObjetDeDonnees rdf:type owl:Class ;
    rdfs:label "Objet de données" ;
    rdfs:comment "Objet de données du référentiel (DO-01..31). ArchiMate: Data Object." .

hea:ObjetMetier rdf:type owl:Class ;
    rdfs:label "Objet métier" ;
    rdfs:comment "Objet métier du référentiel (BO-01..07). ArchiMate: Business Object." .

# ===================================================================
# Classes — Niveau 4 (PTISN)
# ===================================================================

hea:Profil rdf:type owl:Class ;
    rdfs:label "Profil technique" ;
    rdfs:comment "Profil technique d'implémentation (PT-01..19). ArchiMate: Product (extension)." .

hea:Service rdf:type owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "Service technique transverse (SRV-01..06). ArchiMate: Technology Service / Application Service." .

hea:WorkPackage rdf:type owl:Class ;
    rdfs:label "Paquet de travail" ;
    rdfs:comment "Lot de travail ARTSN (WP-01..07). ArchiMate: Work Package." .

# ===================================================================
# Classes — Niveau 5 (Feuille de route)
# ===================================================================

hea:Plateau rdf:type owl:Class ;
    rdfs:label "Plateau" ;
    rdfs:comment "État cible de l'architecture (PL-01..03). ArchiMate: Plateau." .

hea:Gap rdf:type owl:Class ;
    rdfs:label "Écart" ;
    rdfs:comment "Écart entre plateaux (GAP-01..03). ArchiMate: Gap." .

hea:Lieu rdf:type owl:Class ;
    rdfs:label "Lieu" ;
    rdfs:comment "Localisation géographique (LOC-01..06). ArchiMate: Location." .

# ===================================================================
# Classes — Modèle TOGAF (niveau 3 : référentiel d'architecture)
# ===================================================================

hea:ArchitecturePartition rdf:type owl:Class ;
    rdfs:label "Partition d'architecture" ;
    rdfs:comment "Découpage du référentiel cible en partitions transverse, sectorielle ou de flux de valeur. TOGAF: Architecture Partition." .

hea:ArchitectureBuildingBlock rdf:type owl:Class ;
    rdfs:label "Building block d'architecture" ;
    rdfs:comment "Bloc d'architecture réutilisable exposant des services et des contrats (ABB-*). TOGAF: Architecture Building Block." .

hea:SolutionBuildingBlock rdf:type owl:Class ;
    rdfs:label "Building block de solution" ;
    rdfs:comment "Solution composite réalisée par un profil d'implémentation (SBB-*). TOGAF: Solution Building Block." .

hea:ArchitecturePattern rdf:type owl:Class ;
    rdfs:label "Patron d'architecture" ;
    rdfs:comment "Patron de conception répondant à un problème d'architecture récurrent (PAT-*). TOGAF: Architecture Pattern." .

hea:ArchitectureContract rdf:type owl:Class ;
    rdfs:label "Contrat d'architecture" ;
    rdfs:comment "Contrat d'architecture formalisant une relation entre objets (AC-*). TOGAF: Architecture Contract." .

hea:ComplianceRule rdf:type owl:Class ;
    rdfs:label "Règle de conformité" ;
    rdfs:comment "Règle de conformité opposable (COMP-*). TOGAF: Compliance Rule." .

hea:Evidence rdf:type owl:Class ;
    rdfs:label "Preuve" ;
    rdfs:comment "Preuve vérifiable produite par un contrôle d'homologation (EVID-*). TOGAF: Evidence." .

hea:ReferenceData rdf:type owl:Class ;
    rdfs:label "Donnée de référence" ;
    rdfs:comment "Donnée de référence nationale à valeur d'autorité (RD-*). TOGAF: Reference Data." .

hea:Terminology rdf:type owl:Class ;
    rdfs:label "Terminologie" ;
    rdfs:comment "Terminologie et codification communes (TERM-*). TOGAF: Terminology." .

hea:ArchitectureView rdf:type owl:Class ;
    rdfs:label "Vue d'architecture" ;
    rdfs:comment "Vue de consultation du référentiel, dérivée des objets canoniques (VIEW-TOGAF-*). TOGAF: Architecture View." .

# ===================================================================
# Classes — Aliases ArchiMate (équivalents de classes existantes)
# ===================================================================

# ComposantArchitecture : alias de Composant pour la couche applicatif/infrastructure
hea:ComposantArchitecture rdf:type owl:Class ;
    rdfs:label "Composant d'architecture" ;
    rdfs:comment "Alias ArchiMate pour Composant. Couche applicatif/infrastructure/sécurité/gouvernance." ;
    rdfs:subClassOf hea:Composant ;
    owl:equivalentClass hea:Composant .

# ConceptDonnee : alias de ObjetDeDonnees
hea:ConceptDonnee rdf:type owl:Class ;
    rdfs:label "Concept de donnée" ;
    rdfs:comment "Alias ArchiMate pour ObjetDeDonnees. Concept de donnée échangeable entre systèmes." ;
    rdfs:subClassOf hea:ObjetDeDonnees ;
    owl:equivalentClass hea:ObjetDeDonnees .

# FluxDeValeur : alias de FluxValeur (camelCase, sans accent)
hea:FluxDeValeur rdf:type owl:Class ;
    rdfs:label "Flux de valeur" ;
    rdfs:comment "Alias ArchiMate pour FluxValeur. Flux de valeur national." ;
    rdfs:subClassOf hea:FluxValeur ;
    owl:equivalentClass hea:FluxValeur .

# ProfilTechnique : alias de Profil
hea:ProfilTechnique rdf:type owl:Class ;
    rdfs:label "Profil technique" ;
    rdfs:comment "Alias ArchiMate pour Profil. Profil technique d'implémentation." ;
    rdfs:subClassOf hea:Profil ;
    owl:equivalentClass hea:Profil .

# ===================================================================
# Restrictions OWL
# ===================================================================

# ===================================================================
# Propriétés de relation — Conformes ArchiMate 3.1
# ===================================================================

# --- Association (lien générique, dernier recours) ---
# ArchiMate: "The Association relationship models a relationship between elements."
hea:related rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "lié à" ;
    rdfs:comment "Association ArchiMate — lien générique entre deux objets" ;
    owl:domain owl:Thing ;
    owl:range owl:Thing .

# --- Serving (un élément sert un autre) ---
# ArchiMate: "The Serving relationship associates a serving element with the served element."
# Merge de appliesTo (Composant→Capabilite) + gouverns (Composant→Processus) + serves (Service→Acteur)
hea:serves rdf:type owl:ObjectProperty ;
    rdfs:label "sert" ;
    rdfs:comment "Serving ArchiMate — un élément sert un autre (Composant sert Capabilite/Processus/Service, Service sert Acteur/Rôle)" ;
    owl:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Composant hea:Service)
    ] ;
    owl:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Capabilite hea:ProcessusMetier hea:Service hea:PartiePrenante hea:Acteur)
    ] .

# --- Realization (un élément réalise un autre) ---
# ArchiMate: "The Realization relationship models that an element (typically an active structure element)
# realizes another element (typically a behavioral element)."
hea:realizedBy rdf:type owl:ObjectProperty ;
    rdfs:label "réalisé par" ;
    rdfs:comment "Realization ArchiMate — un élément actif réalise un élément comportemental" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Capabilite hea:EtapeValeur)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Service hea:Composant)
    ] .

# --- Access (un élément comportemental accède à un objet) ---
# ArchiMate: "The Access relationship associates a behavioral element with an object that is accessed."
# Behavioral elements: Process, Function, Interaction, Service.
# Objects: Data Object, Artifact.
# Extension HEA : le composant applicatif accède aux objets de données qu'il porte,
# et le service de terminologie accède aux terminologies qu'il sert.
hea:accesses rdf:type owl:ObjectProperty ;
    rdfs:label "accède à" ;
    rdfs:comment "Access ArchiMate — un processus, un service ou un composant accède à un objet de données, un objet métier ou une terminologie" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:ProcessusMetier hea:Service hea:Composant)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:ObjetDeDonnees hea:ObjetMetier hea:Terminology)
    ] .

hea:accessedBy rdf:type owl:ObjectProperty ;
    rdfs:label "accédé par" ;
    rdfs:comment "Inverse de hea:accesses pour naviguer depuis les objets métier, les objets de données et les terminologies" ;
    owl:inverseOf hea:accesses ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:ObjetDeDonnees hea:ObjetMetier hea:Terminology)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:ProcessusMetier hea:Service hea:Composant)
    ] .

# --- Semantic constraint (un objet de données est codé par une terminologie) ---
# Extension HEA : ArchiMate 3.1 ne prévoit pas de relation native entre un objet
# de données et un référentiel de codes. La contrainte sémantique est modélisée
# comme une Association dont le sens est unidirectionnel côté objet de données.
hea:constrainedBy rdf:type owl:ObjectProperty ;
    rdfs:label "contraint par" ;
    rdfs:comment "Association sémantique HEA — les valeurs d'un objet de données sont codées par une terminologie" ;
    rdfs:domain hea:ObjetDeDonnees ;
    rdfs:range hea:Terminology .

hea:constrains rdf:type owl:ObjectProperty ;
    rdfs:label "contraint" ;
    rdfs:comment "Inverse de hea:constrainedBy pour naviguer depuis la terminologie vers les objets de données qu'elle régit" ;
    owl:inverseOf hea:constrainedBy ;
    rdfs:domain hea:Terminology ;
    rdfs:range hea:ObjetDeDonnees .

# --- Realization (un processus métier réalise une capacité) ---
# ArchiMate: "The Realization relationship models that an element (typically an active structure element)
# realizes another element (typically a behavioral element)."
# Couche Business du référentiel : le processus métier est la réalisation de la capacité.
hea:realise rdf:type owl:ObjectProperty ;
    rdfs:label "réalise" ;
    rdfs:comment "Realization ArchiMate — un processus métier réalise une capacité métier" ;
    rdfs:domain hea:ProcessusMetier ;
    rdfs:range hea:Capabilite .

# --- Serving inverse (un processus est servi par un composant) ---
# Symétrique de hea:serves, dans le sens de la lecture métier vers application.
hea:serviPar rdf:type owl:ObjectProperty ;
    rdfs:label "servi par" ;
    rdfs:comment "Serving ArchiMate — un processus métier est servi par un composant applicatif" ;
    owl:inverseOf hea:serves ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:ProcessusMetier hea:Service)
    ] ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Composant hea:Service)
    ] .

# --- Assignment (responsabilité) ---
# ArchiMate: "The Assignment relationship models the assignment of responsibility for performing behavior
# to an entity that performs behavior."
hea:performs rdf:type owl:ObjectProperty ;
    rdfs:label "exécute" ;
    rdfs:comment "Assignment ArchiMate — un acteur ou rôle exécute un processus" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Acteur hea:Role)
    ] ;
    rdfs:range hea:ProcessusMetier .

hea:assignedTo rdf:type owl:ObjectProperty ;
    rdfs:label "assigné à" ;
    rdfs:comment "Assignment ArchiMate — un rôle est assigné à un acteur" ;
    rdfs:domain hea:Role ;
    rdfs:range hea:Acteur .

hea:hasRole rdf:type owl:ObjectProperty ;
    rdfs:label "a pour rôle" ;
    rdfs:comment "Assignment ArchiMate — un acteur a un rôle" ;
    rdfs:domain hea:Acteur ;
    rdfs:range hea:Role .

# --- Representation (un élément représente un autre) ---
# ArchiMate: "The Representation relationship models that an element is a representation of another element."
hea:represents rdf:type owl:ObjectProperty ;
    rdfs:label "représente" ;
    rdfs:comment "Representation ArchiMate — un acteur représente une partie prenante" ;
    rdfs:domain hea:Acteur ;
    rdfs:range hea:PartiePrenante .

# --- Influence (un élément influence un autre) ---
# ArchiMate: "The Influence relationship models that an element influences the change or behavior of another element."
hea:contributesTo rdf:type owl:ObjectProperty ;
    rdfs:label "contribue à" ;
    rdfs:comment "Influence ArchiMate — une étape de valeur ou un processus contribue à un flux de valeur" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:EtapeValeur hea:ProcessusMetier hea:Capabilite hea:Principe hea:FluxValeur hea:WorkPackage)
    ] ;
    owl:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:FluxValeur hea:Capabilite hea:Plateau)
    ] .

# --- Mapping inter-niveaux (Association, extension domain-specific) ---
# Pas de relationship ArchiMate standard pour la correspondance cross-layer.
# Association générique de correspondance entre couches. Le type autorisé de
# la cible dépend du type de la source et est contrôlé par les shapes SHACL
# (hea-shapes.ttl), qui décrivent mieux que l'ontologie la réalité du corpus :
# un profil correspond à un chapitre, un composant à une capacité, un objet
# de données à une capacité, etc.
hea:mapsTo rdf:type owl:ObjectProperty ;
    rdfs:label "correspond à" ;
    rdfs:comment "Association ArchiMate — correspondance inter-couches (profil, chapitre, exigence, patron, contrat, composant, objet de données vers référentiel, capacité, partition ou composant). Le type de la cible est contraint par source dans les shapes SHACL." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource .

# --- Implements (Realization, extension domain-specific) ---
# Un profil met en œuvre un chapitre ou une fondation.
hea:implements rdf:type owl:ObjectProperty ;
    rdfs:label "met en œuvre" ;
    rdfs:comment "Realization ArchiMate — un profil met en œuvre un chapitre ou une fondation" ;
    rdfs:domain hea:Profil ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (hea:Chapitre hea:Fondation)
    ] .

# --- LocatedAt (Association, extension — pas d'équivalent direct ArchiMate) ---
# ArchiMate a un concept Location mais pas de relationship "locatedAt" standard.
# Modélisé comme Association.
hea:locatedAt rdf:type owl:ObjectProperty ;
    rdfs:label "situé à" ;
    rdfs:comment "Association ArchiMate — un composant ou service est situé dans un lieu" ;
    rdfs:domain [
        rdf:type owl:Class ;
        owl:unionOf (hea:Composant hea:Service)
    ] ;
    rdfs:range hea:Lieu .

# --- Composition (un flux de valeur produit une valeur) ---
# ArchiMate: "The Composition relationship models the containment of components."
# Un FluxValeur compose/définit une Valeur qu'il produit.
hea:produit rdf:type owl:ObjectProperty ;
    rdfs:label "produit" ;
    rdfs:comment "Composition ArchiMate — un flux de valeur produit une valeur" ;
    owl:domain hea:FluxValeur ;
    owl:range hea:Valeur .

# --- Association (une valeur est détenue par une partie prenante) ---
# ArchiMate: "The Association relationship models a relationship between elements."
# La valeur est associée à (détenue par) une partie prenante.
hea:detenuPar rdf:type owl:ObjectProperty ;
    rdfs:label "détenu par" ;
    rdfs:comment "Association ArchiMate — une valeur est détenue par une partie prenante" ;
    owl:domain hea:Valeur ;
    owl:range hea:PartiePrenante .

# --- Composition (un composant soutient un flux de valeur) ---
# ArchiMate: Composition — un composant actif soutient un flux de valeur.
hea:soutientFluxDeValeur rdf:type owl:ObjectProperty ;
    rdfs:label "soutient le flux de valeur" ;
    rdfs:comment "Composition ArchiMate — un composant soutient un flux de valeur" ;
    owl:domain hea:Composant ;
    owl:range hea:FluxValeur .

# --- Association (un composant utilise un autre composant) ---
# ArchiMate: Association — lien entre deux composants actifs.
hea:utiliseComposant rdf:type owl:ObjectProperty ;
    rdfs:label "utilise le composant" ;
    rdfs:comment "Association ArchiMate — un composant utilise un autre composant" ;
    owl:domain hea:Composant ;
    owl:range hea:Composant .

# --- Association (un composant supporte un standard/chapitre) ---
# ArchiMate: Association — un composant supporte un chapitre ARTSN.
hea:supporteStandard rdf:type owl:ObjectProperty ;
    rdfs:label "supporte le standard" ;
    rdfs:comment "Association ArchiMate — un composant supporte un standard ou chapitre ARTSN" ;
    owl:domain hea:Composant ;
    owl:range hea:Chapitre .

# --- Serving (un profil a pour propriétaire fonctionnel une partie prenante) ---
# ArchiMate: Serving — un profil technique est servi par une partie prenante (propriétaire fonctionnel).
hea:aPourProprietaireFonctionnel rdf:type owl:ObjectProperty ;
    rdfs:label "a pour propriétaire fonctionnel" ;
    rdfs:comment "Serving ArchiMate — un profil technique a pour propriétaire fonctionnel une partie prenante" ;
    owl:domain hea:Profil ;
    owl:range hea:PartiePrenante .

# --- Aggregation/Realization (un profil définit un objet de données) ---
# ArchiMate: Realization/Aggregation — un profil (Product) définit les objets de
# données dont son API consomme les payloads (contrats d'implémentation).
hea:defines rdf:type owl:ObjectProperty ;
    rdfs:label "définit" ;
    rdfs:comment "Realization ArchiMate — un profil technique définit les objets de données dont son API référence les payloads (dérivé de x-hea-data-objects)" ;
    owl:domain hea:Profil ;
    owl:range hea:ObjetDeDonnees .

# ===================================================================
# Propriétés de données (Datatype Properties)
# ===================================================================

hea:id rdf:type owl:DatatypeProperty ;
    rdfs:label "identifiant" ;
    rdfs:comment "Identifiant normalisé unique de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:title rdf:type owl:DatatypeProperty ;
    rdfs:label "titre" ;
    rdfs:comment "Titre canonique de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:status rdf:type owl:DatatypeProperty ;
    rdfs:label "statut" ;
    rdfs:comment "Statut de maturité (draft, active, stable, candidate, deprecated)" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:owner rdf:type owl:DatatypeProperty ;
    rdfs:label "propriétaire" ;
    rdfs:comment "Entité responsable de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:version rdf:type owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "Version de l'objet" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

hea:niveau rdf:type owl:DatatypeProperty ;
    rdfs:label "niveau" ;
    rdfs:comment "Niveau de référence : 1 (CAESN), 2 (CNISN), 3 (ARTSN), 4 (PTISN)" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:integer .

hea:tag rdf:type owl:DatatypeProperty ;
    rdfs:label "étiquette" ;
    rdfs:comment "Étiquette de catégorisation" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

# ===================================================================
# Annotations FHIR (metadata, pas relationships ArchiMate)
# ===================================================================

# Annotation property : type de ressource FHIR (ex. Patient, Encounter, Organization)
fhir:fhirResource rdf:type owl:AnnotationProperty ;
    rdfs:label "FHIR resource type" ;
    rdfs:comment "Type de ressource FHIR R4 associé à un objet de données (ex. Patient, Encounter, Organization)" ;
    owl:domain hea:ObjetDeDonnees ;
    rdfs:range xsd:string .

# Annotation property : URL du profil FHIR (ex. http://hl7.org/fhir/us/mcsd/StructureDefinition/mcsd-patient)
fhir:fhirProfile rdf:type owl:AnnotationProperty ;
    rdfs:label "FHIR profile URL" ;
    rdfs:comment "URL du profil FHIR R4 associé à un profil technique (ex. http://hl7.org/fhir/us/mcsd/...)" ;
    owl:domain hea:Profil ;
    rdfs:range xsd:string .

# Annotation property : version FHIR cible
fhir:fhirVersion rdf:type owl:AnnotationProperty ;
    rdfs:label "FHIR version" ;
    rdfs:comment "Version FHIR cible (ex. 4.0.1 pour R4)" ;
    owl:domain owl:Thing ;
    rdfs:range xsd:string .

# Annotation property : spécification OpenAPI d'un profil
hea:openapiSpec rdf:type owl:AnnotationProperty ;
    rdfs:label "spécification OpenAPI" ;
    rdfs:comment "IRI de la spécification OpenAPI 3.0 générée pour le profil (03_ptisn/schemas/openapi/pt-XX.json)" ;
    owl:domain hea:Profil ;
    rdfs:range xsd:anyURI .

# ===================================================================
# Restrictions de cardinalité (owl:Restriction)
# ===================================================================

# Tout profil doit avoir au moins 1 mapsTo
hea:ProfilMinMapsTo rdf:type owl:Restriction ;
    owl:onProperty hea:mapsTo ;
    owl:minCardinality 1 ;
    rdfs:subClassOf hea:Profil .

# Tout ancien paquet d'interopérabilité doit avoir au moins 1 mapsTo vers un CAP
hea:CapIntMinMapsTo rdf:type owl:Restriction ;
    owl:onProperty hea:mapsTo ;
    owl:minCardinality 1 ;
    rdfs:subClassOf hea:CapaciteInteroperabilite .
