{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-13.json",
  "title": "DO-13 — DO-13 : Stock",
  "description": "Quantité disponible d'un produit de santé dans un point de stockage (entrepôt, formation sanitaire, case de santé). Il est calculé comme le solde entre les entrées (réceptions, transferts) et les sorties (dispensations, pertes, péremptions).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "quantite": {
      "type": "integer",
      "minimum": 0,
      "description": "Quantité"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_9Ref": {
      "type": "string",
      "description": "Référence à ART-9"
    },
    "bo_03Ref": {
      "type": "string",
      "description": "Référence à BO-03"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-13",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "MedicationDispense",
  "x-hea-source-ref": "LMIS ( Logistics Management Information System)"
}