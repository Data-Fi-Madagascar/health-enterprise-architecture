{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-02.json",
  "title": "DO-02 — DO-02 : Identifiant national d'identification",
  "description": "Code alphanumérique unique attribué à chaque patient dans le référentiel national des bénéficiaires. Il garantit l'unicité de l'identité patient à travers tous les systèmes et toutes les initiatives.",
  "type": "string",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_7Ref": {
      "type": "string",
      "description": "Référence à ART-7"
    },
    "bo_01Ref": {
      "type": "string",
      "description": "Référence à BO-01"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-02",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "",
  "x-hea-source-ref": "Référentiel des bénéficiaires / patients"
}