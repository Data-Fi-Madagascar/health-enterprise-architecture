{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-10.json",
  "title": "DO-10 — DO-10 : Dispensation",
  "description": "Fourniture effective d'un produit de santé (médicament, vaccin, intrant) à un patient, en exécution d'une prescription. Elle constitue l'acte de sortie du stock et doit être tracée pour la gestion des stocks, la facturation et le suivi thérapeutique.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "quantite": {
      "type": "integer",
      "minimum": 0,
      "description": "Quantité"
    },
    "lot": {
      "type": "string",
      "description": "Numéro de lot"
    },
    "patientRef": {
      "type": "string",
      "description": "Référence au patient (DO-01)"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_9Ref": {
      "type": "string",
      "description": "Référence à ART-9"
    },
    "bo_03Ref": {
      "type": "string",
      "description": "Référence à BO-03"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-10",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "MedicationDispense",
  "x-hea-source-ref": "FHIR MedicationDispense"
}