{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-04.json",
  "title": "DO-04 — DO-04 : Épisode de soins",
  "description": "Période continue de prise en charge d'un patient par un ou plusieurs prestataires de soins, depuis l'admission jusqu'à la sortie ou le transfert. Un épisode peut couvrir une consultation, une hospitalisation, un suivi communautaire ou une téléconsultation.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "patientRef": {
      "type": "string",
      "description": "Référence au patient (DO-01)"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_7Ref": {
      "type": "string",
      "description": "Référence à ART-7"
    },
    "bo_01Ref": {
      "type": "string",
      "description": "Référence à BO-01"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-04",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "Patient",
  "x-hea-source-ref": "FHIR Encounter"
}