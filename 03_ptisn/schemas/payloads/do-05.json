    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_3Ref": {
      "type": "string",
      "description": "Référence à ART-3"
    },
    "bo_02Ref": {
      "type": "string",
      "description": "Référence à BO-02"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-05",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "ExplanationOfBenefit",
