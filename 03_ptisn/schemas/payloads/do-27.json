{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-27.json",
  "title": "DO-27 — DO-27 : Tâche",
  "description": "Unité de travail assignée à un acteur (personne ou système) dans le cadre d'un processus opérationnel : investigation terrain, campagne de vaccination, distribution d'intrants, visite de suivi. La tâche porte un statut, des échéances et une traçabilité complète d'exécution.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "statut": {
      "type": "string",
      "description": "Statut de l'objet"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "bo_06Ref": {
      "type": "string",
      "description": "Référence à BO-06"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-27",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "",
  "x-hea-source-ref": "FHIR Task"
}