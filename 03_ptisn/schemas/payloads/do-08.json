{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-08.json",
  "title": "DO-08 — DO-08 : Contre-référence",
  "description": "Retour d'un patient vers l'établissement d'origine après prise en charge spécialisée, accompagné du compte-rendu clinique, des recommandations de suivi et de la prise en charge thérapeutique à poursuivre. La contre-référence clôture le parcours inter-établissement et rétablit la responsabilité clinique au niveau d'origine.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "patientRef": {
      "type": "string",
      "description": "Référence au patient (DO-01)"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_3Ref": {
      "type": "string",
      "description": "Référence à ART-3"
    },
    "bo_02Ref": {
      "type": "string",
      "description": "Référence à BO-02"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-08",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "Account",
  "x-hea-source-ref": "FHIR ServiceRequest (type: referral) + FHIR DocumentReference (compte-rendu)"
}