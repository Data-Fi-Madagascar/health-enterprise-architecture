{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-01.json",
  "title": "DO-01 — DO-01 : Patient",
  "description": "Personne physique bénéficiaire de soins de santé, identifiée de manière unique au sein du système d'information sanitaire national. L'identité du patient est un actif stratégique national qui ne peut être dupliquée, fragmentée ou remplacée par des identifiants propriétaires de programmes ou de projets.",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "system",
          "value"
        ]
      },
      "description": "Au moins un identifiant national (NIN) exigé ; identifiants provisoires autorisés en attente d'attribution."
    },
    "name": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "use": {
            "type": "string",
            "enum": [
              "official",
              "usual",
              "nickname"
            ]
          },
          "family": {
            "type": "string"
          },
          "given": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Nom usuel obligatoire, au minimum un HumanName."
    },
    "birthDate": {
      "type": "string",
      "format": "date",
      "description": "Date de naissance exigée, au besoin estimée (patient.birthDate + patient.deceasedBoolean gérés à part)."
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other",
        "unknown"
      ],
      "description": "Sexe administratif requis, codé sur la ValueSet FHIR administrative-gender."
    },
    "address": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          }
        }
      },
      "description": "Adresse du patient, référençable vers le référentiel géospatial national (ART-4D)."
    },
    "security": {
      "type": "object",
      "properties": {
        "security": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Balises de classification des données (résidence, confidentialité) conformes à ART-7."
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_7Ref": {
      "type": "string",
      "description": "Référence à ART-7"
    },
    "bo_01Ref": {
      "type": "string",
      "description": "Référence à BO-01"
    }
  },
  "required": [
    "id",
    "identifier",
    "name",
    "birthDate",
    "gender"
  ],
  "x-hea-version": "1.0.0",
  "x-hea-id": "DO-01",
  "x-hea-type": "objet-de-donnees",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "Patient",
  "x-hea-fhir-resources": [
    "Patient"
  ],
  "x-hea-source-ref": "Référentiel des bénéficiaires / patients (CAESN)"
}