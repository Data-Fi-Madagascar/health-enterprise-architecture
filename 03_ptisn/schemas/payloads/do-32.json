{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-32.json",
  "title": "DO-32 — DO-32 : Examen et résultat de laboratoire",
  "description": "Examen biologique, microbiologique, parasitologique, sérologique ou d'imagerie réalisé sur un échantillon prélevé chez un patient, et résultat d'analyse associé. L'objet couvre la demande d'examen, l'échantillon analysé, le résultat, son unité, sa valeur de référence et son interprétation. Le résultat est la preuve de confirmation d'un diagnostic, la base du suivi de l'efficacité d'un traitement et l'intrant de la surveillance épidémiologique et de la riposte.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet",
      "const": "DO-32"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de l'événement"
    },
    "patientRef": {
      "type": "string",
      "description": "Référence au patient (DO-01)"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_cours",
        "confirme",
        "infirme",
        "cloture"
      ],
      "description": "Statut de l'objet"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "bo_02Ref": {
      "type": "string",
      "description": "Référence à BO-02"
    },
    "bo_05Ref": {
      "type": "string",
      "description": "Référence à BO-05"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-version": "1.0.0",
  "x-hea-id": "DO-32",
  "x-hea-type": "objet-de-donnees",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "DiagnosticReport",
  "x-hea-fhir-resources": [
    "DiagnosticReport",
    "Observation"
  ],
  "x-hea-source-ref": "FHIR DiagnosticReport et FHIR Observation, codification LOINC"
}