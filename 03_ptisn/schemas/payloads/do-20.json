{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-20.json",
  "title": "DO-20 — DO-20 : Investigation",
  "description": "Enquête épidémiologique et/ou de laboratoire menée pour confirmer ou infirmer un signal, identifier la source, le mode de transmission et les facteurs de risque d'un événement sanitaire.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_3Ref": {
      "type": "string",
      "description": "Référence à ART-3"
    },
    "bo_05Ref": {
      "type": "string",
      "description": "Référence à BO-05"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-20",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "",
  "x-hea-source-ref": "DHIS2, OMS protocoles"
}