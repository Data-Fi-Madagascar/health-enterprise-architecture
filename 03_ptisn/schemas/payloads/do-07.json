{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-07.json",
  "title": "DO-07 — DO-07 : Référence",
  "description": "Orientation d'un patient d'un niveau de soins vers un autre (ex. : centre de santé vers hôpital), accompagnée des informations cliniques pertinentes pour la prise en charge ultérieure. La référence initie un parcours inter-établissement : elle est émise par le prestataire d'origine et acceptée par l'établissement de destination.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_3Ref": {
      "type": "string",
      "description": "Référence à ART-3"
    },
    "bo_02Ref": {
      "type": "string",
      "description": "Référence à BO-02"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-07",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "ExplanationOfBenefit",
  "x-hea-source-ref": "FHIR ServiceRequest (type: referral)"
}