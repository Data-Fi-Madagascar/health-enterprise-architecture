{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-25.json",
  "title": "DO-25 — DO-25 : Indicateur sanitaire",
  "description": "Mesure standardisée d'une performance, d'un résultat ou d'un processus dans le domaine de la santé. Chaque indicateur doit avoir une définition unique, stable et partagée, avec une méthodologie de calcul précise.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "bo_06Ref": {
      "type": "string",
      "description": "Référence à BO-06"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-25",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "",
  "x-hea-source-ref": "Référentiel des indicateurs sanitaires (CAESN), DHIS2"
}