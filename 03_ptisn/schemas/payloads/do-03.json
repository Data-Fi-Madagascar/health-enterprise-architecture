{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healmadagascar.mg/schemas/payloads/do-03.json",
  "title": "DO-03 — DO-03 : Dossier patient",
  "description": "Ensemble structuré des informations cliniques, administratives et de suivi relatives à un patient au cours de sa vie. Il comprend les antécédents, les épisodes de soins, les prescriptions, les résultats d'examens et les documents cliniques.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "patientRef": {
      "type": "string",
      "description": "Référence au patient (DO-01)"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "art_7Ref": {
      "type": "string",
      "description": "Référence à ART-7"
    },
    "bo_01Ref": {
      "type": "string",
      "description": "Référence à BO-01"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-03",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "Patient",
  "x-hea-source-ref": "FHIR Patient, IHE PCD"
}