  "title": "DO-23 — DO-23 : Formation sanitaire",
  "description": "Toute structure de soins publique, privée, confessionnelle ou communautaire identifiée de manière unique dans le référentiel national des formations sanitaires. C'est l'unité de base du réseau de soins.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant unique de l'objet"
    },
    "version": {
      "type": "string",
      "description": "Version de l'objet",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "statut": {
      "type": "string",
      "description": "Statut de l'objet"
    },
    "art_2Ref": {
      "type": "string",
      "description": "Référence à ART-2"
    },
    "art_4Ref": {
      "type": "string",
      "description": "Référence à ART-4"
    },
    "bo_06Ref": {
      "type": "string",
      "description": "Référence à BO-06"
    }
  },
  "required": [
    "id",
    "version"
  ],
  "x-hea-id": "DO-23",
  "x-hea-type": "objet-de-donnees",
  "x-hea-version": "1.0.0",
  "x-hea-status": "draft",
  "x-hea-owner": "DEPSI",
  "x-hea-fhir-resource": "",
  "x-hea-source-ref": "Référentiel des formations sanitaires (CAESN)"
}